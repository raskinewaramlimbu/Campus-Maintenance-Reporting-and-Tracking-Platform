# Copy this file to .env and fill in your own values. .env is gitignored.

# MongoDB Atlas connection string (or a local mongod instance).
# Example Atlas format:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fixmycampus
MONGODB_URI=mongodb://127.0.0.1:27017/fixmycampus

# Used to sign JWTs - make this a long random string in real deployments,
# this is just a placeholder for local dev.
JWT_SECRET=change-this-to-something-long-and-random
JWT_EXPIRES_IN=8h

PORT=4000

# Comma-separated list of origins allowed to call the API. Vite's default
# dev port is included already.
CORS_ORIGIN=http://localhost:5173

# Optional - only needed if you want real emails for the reminder digest.
# If these are left blank the app just logs what it would have sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=fixmycampus@example.com

# How many days a report can sit without a status change before it shows
# up in the "overdue" reminders list.
REMINDER_THRESHOLD_DAYS=3
